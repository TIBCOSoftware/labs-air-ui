{
  "name": "ProjectAir",
  "version": "0.7.0-725",
  "workspaces": [
    "projects/cloud",
    "projects/on-prem",
    "projects/common"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve on-prem --ssl true",
    "start-cloud": "ng serve cloud --ssl true",
    "build": "ng build on-prem",
    "build-cloud": "ng build cloud",
    "build-common": "ng build common",
    "watch": "ng build --watch --configuration development",
    "test": "ng test common && ng test on-prem && ng test cloud",
    "lint": "ng lint --fix && npx stylelint --fix \"projects/**/*.css\"",
    "prepare": "(husky install && git config --local commit.template .commit-template) || echo Could not setup the commit template && ng build common",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~13.3.3",
    "@angular/cdk": "~13.3.3",
    "@angular/common": "~13.3.3",
    "@angular/compiler": "~13.3.3",
    "@angular/core": "~13.3.3",
    "@angular/flex-layout": "~13.0.0-beta.38",
    "@angular/forms": "~13.3.3",
    "@angular/material": "~13.3.3",
    "@angular/platform-browser": "~13.3.3",
    "@angular/platform-browser-dynamic": "~13.3.3",
    "@angular/router": "~13.3.3",
    "@tibco/spotfire-wrapper": "^0.16.0",
    "@TIBCOSoftware/labs-air-graph-client": "file:./TIBCOSoftware-labs-air-graph-client-0.0.31.tgz",
    "@types/lodash": "~4.14.171",
    "chart.js": "3.6.0",
    "chartjs-adapter-luxon": "^1.1.0",
    "chartjs-plugin-datalabels": "^2.0.0",
    "chartjs-plugin-doughnutlabel": "^2.0.3",
    "chartjs-plugin-labels": "^1.1.0",
    "chartjs-plugin-streaming": "^2.0.0",
    "ng2-charts": "^3.0.9",
    "ng2-google-charts": "~7.0.0",
    "ngx-heatmap": "^1.0.2",
    "rete": "^1.4.7",
    "rete-angular-render-plugin": "^0.2.2",
    "rete-area-plugin": "^0.2.1",
    "rete-connection-plugin": "^0.9.0",
    "rete-context-menu-plugin": "^0.6.0-rc.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.1",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~13.3.3",
    "@angular-eslint/builder": "13.2.1",
    "@angular-eslint/eslint-plugin": "13.2.1",
    "@angular-eslint/eslint-plugin-template": "13.2.1",
    "@angular-eslint/schematics": "13.2.1",
    "@angular-eslint/template-parser": "13.2.1",
    "@angular/cli": "^13.3.3",
    "@angular/compiler-cli": "~13.3.3",
    "@angular/elements": "~13.3.3",
    "@commitlint/cli": "^16.1.0",
    "@commitlint/config-conventional": "^16.0.0",
    "@types/jasmine": "~3.10.3",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^5.20.0",
    "@typescript-eslint/parser": "^5.20.0",
    "eslint": "^8.13.0",
    "husky": "^7.0.4",
    "install": "^0.13.0",
    "jasmine-core": "~4.0.0",
    "karma": "~6.3.16",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.7.0",
    "ng-packagr": "^13.3.1",
    "postcss": "^8.4.6",
    "postcss-loader": "~6.2.1",
    "puppeteer": "^13.3.1",
    "standard-version": "^9.3.1",
    "standard-version-updater-yaml": "^1.0.3",
    "stylelint": "^14.7.1",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "stylelint-config-standard": "^25.0.0",
    "typescript": "~4.6.3",
    "yaml-validator": "^4.0.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}